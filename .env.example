# Copie para .env com `npm run setup` (gera segredos aleatórios locais).
# Os valores abaixo são apenas marcadores; nenhum segredo real vive neste repositório.

# Banco (um Postgres, três bancos: crm, erp, ponte).
# ponte:ponte é o usuário e a senha do PostgreSQL local de desenvolvimento (contêiner descartável); não é um segredo.
CRM_DATABASE_URL=postgresql://ponte:ponte@localhost:5452/crm
ERP_DATABASE_URL=postgresql://ponte:ponte@localhost:5452/erp
PONTE_DATABASE_URL=postgresql://ponte:ponte@localhost:5452/ponte

# Portas
CRM_PORT=4001
ERP_PORT=4002
PONTE_PORT=4000
CONSOLE_PORT=4003

# URLs entre serviços
CRM_URL=http://localhost:4001
ERP_URL=http://localhost:4002
PONTE_URL=http://localhost:4000

# Segredos de webhook (HMAC-SHA256). CRM -> Ponte e ERP -> Ponte.
CRM_WEBHOOK_SECRET=change-me
ERP_WEBHOOK_SECRET=change-me

# Chaves de API entre serviços
CRM_API_KEY=change-me
ERP_API_KEY=change-me
PONTE_ADMIN_KEY=change-me

# Política de retentativa da Ponte (padrão do estudo: ~3h de janela)
RETRY_MAX_ATTEMPTS=12
RETRY_BASE_MS=30000
RETRY_CAP_MS=1800000

# Regras de negócio
CONFERENCE_THRESHOLD_CENTS=5000000

# Alerta de fila parada (v1.1): espera máxima de trabalho vencido, em segundos (5 min = limite do RNF-01)
QUEUE_STALL_SECONDS=300

# Reconciliação (intervalo em segundos; carência para negócios recém-ganhos)
RECON_INTERVAL_SECONDS=900
RECON_GRACE_SECONDS=120
